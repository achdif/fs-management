# Server Environment
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# SurrealDB Cloud
SURREALDB_URL=wss://your-instance.surrealdb.cloud/rpc
SURREALDB_NAMESPACE=your_namespace
SURREALDB_DATABASE=your_database
SURREALDB_USERNAME=your_username
SURREALDB_PASSWORD=your_password

# Upstash Redis
UPSTASH_REDIS_URL=rediss://default:your_redis_token@your-redis.upstash.io:6379
# Alternatively REST:
UPSTASH_REST_URL=https://your-redis.upstash.io
UPSTASH_REST_TOKEN=your_redis_token

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRATION_MINUTES=15
REFRESH_TOKEN_EXPIRATION_DAYS=30

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

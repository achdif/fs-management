{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@fs-management/auth": ["../../packages/auth/src"],
      "@fs-management/auth/*": ["../../packages/auth/src/*"],
      "@fs-management/shared": ["../../packages/shared/src"],
      "@fs-management/shared/*": ["../../packages/shared/src/*"],
      "@fs-management/booking": ["../../packages/booking/src"],
      "@fs-management/booking/*": ["../../packages/booking/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
